<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardFragment">

    <fragment
        android:id="@+id/onboardFragment"
        android:name="ru.averkiev.budget.fragments.OnboardFragment"
        tools:layout="@layout/fragment_onboard">
        <action
            android:id="@+id/action_onboardFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="ru.averkiev.budget.fragments.SignInFragment"
        tools:layout="@layout/fragment_sign_in">
        <argument
            android:name="user"
            android:defaultValue="@null"
            app:argType="ru.averkiev.budget.models.User"
            app:nullable="true" />
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment">
            <argument
                android:name="login"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="ru.averkiev.budget.fragments.SignUpFragment"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment">
            <argument
                android:name="user"
                android:defaultValue="@null"
                app:argType="ru.averkiev.budget.models.User"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="ru.averkiev.budget.fragments.HomeFragment"
        tools:layout="@layout/fragment_home">
        <argument
            android:name="login"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>